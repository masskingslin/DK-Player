<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DKPlayer" parent="android:Theme.Material.NoActionBar">
        <!-- Window & Fullscreen Configuration for TV & Mobile -->
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowOverscan">false</item>
        <item name="android:windowIsTranslucent">false</item>

        <!-- System Bar Transparency for Edge-to-Edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- System Color Palette Mapping -->
        <item name="android:colorPrimary">@color/tv_primary</item>
        <item name="android:colorBackground">@color/tv_background</item>
    </style>
</resources>
