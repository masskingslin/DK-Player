<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat parent: the Cast device chooser (MediaRouteChooserDialog) is an AppCompatDialog
         and throws "You need to use a Theme.AppCompat theme" on a plain android: theme. -->
    <style name="Theme.DKPlayer" parent="Theme.AppCompat.NoActionBar">
        <!-- Window configuration (edge-to-edge is enabled in MainActivity; the video player hides the bars itself) -->
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowOverscan">false</item>
        <item name="android:windowIsTranslucent">false</item>

        <!-- System Bar Transparency for Edge-to-Edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- System Color Palette Mapping -->
        <item name="android:colorPrimary">@color/tv_primary</item>
        <item name="android:colorBackground">@color/tv_background</item>

        <!-- AppCompat-namespace attributes. androidx.mediarouter (the Cast button) reads these
             and crashes with "background can not be translucent: #0" when they are missing,
             which they are on a plain android:Theme.Material parent. -->
        <item name="colorPrimary">@color/tv_primary</item>
        <item name="colorPrimaryDark">@color/tv_primary_dark</item>
        <item name="colorAccent">@color/tv_primary</item>
    </style>
</resources>
